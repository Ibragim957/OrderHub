# Скопируйте в .env и при необходимости поменяйте значения.
# Сам .env в git не попадает (см. .gitignore) — секреты не должны быть в репозитории.

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB_1=service_1_db
POSTGRES_DB_2=service_2_db

# --- RabbitMQ ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- JWT ---
# В проде это должен быть длинный случайный ключ из секрет-хранилища.
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Прочее ---
SQL_ECHO=0
